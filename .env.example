# Local LLM for the chat assistant (llama.cpp, Ollama, vLLM or any other
# OpenAI-compatible API on this machine - used when LOCAL_AI=llm)
LOCAL_LLM_API_BASE=http://localhost:11434/v1
LOCAL_LLM_API_KEY=ollama
LOCAL_LLM_MODEL=gemma4:latest

# How documents are analysed: 'ner-browser' (default, bundled NER model),
# 'llm' (chat assistant with the local LLM above) or 'ner' (spaCy, Docker only)
LOCAL_AI=ner-browser

# Start the assistant's conversation with the document text already read.
# Small local models need this; without it they often ask for an upload.
# PRELOAD_DOCUMENT=true

# Reasoning setting passed to the local LLM, e.g. 'none' to switch thinking off
# LOCAL_LLM_REASONING_EFFORT=none

# 'local' serves the NER model and its runtime from the app and disables all
# downloads; 'remote' (default) fetches them on first use
# NER_MODELS=local

# Source of the FOI/IFG redaction rules: 'github' (default, fetched from
# datenlabor-bmz/redaction-rules) or 'local' (bundled JSON in src/data/rules)
REDACTION_RULES_SOURCE=github

# Default UI language (optional): en, de, fr, es, ru, ar, zh
# DEFAULT_LOCALE=de

# Docker-only: uncomment when running in container
# LIBREOFFICE_PATH=/usr/bin/libreoffice
