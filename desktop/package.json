{
  "name": "localredact-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Offline desktop app for redacting sensitive data in PDF and DOCX files",
  "author": "LocalRedact contributors",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/christian-klng/localredact",
  "main": "main.js",
  "scripts": {
    "fetch:models": "node fetch-models.mjs",
    "build:server": "node build-server.mjs",
    "start": "electron .",
    "smoke": "electron . --smoke",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "io.github.localredact",
    "productName": "LocalRedact",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "executableName": "localredact"
    },
    "afterPack": "./after-pack.js"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  }
}
